# Copiez ce fichier en .env (ou .env.local) et renseignez les valeurs.
# Sur Vercel : Project > Settings > Environment Variables.
# Ne commitez JAMAIS les vraies valeurs.

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.cathbiz-africa.org

# ─── SMTP (boîte contact@cathbiz-africa.org) ─────────────────
SMTP_HOST=mx-dc03.ewodi.net
SMTP_PORT=465
SMTP_USER=contact@cathbiz-africa.org
SMTP_PASS=

# Destinataires des formulaires (contact, candidatures, adhésions)
CONTACT_TO=contact@cathbiz-africa.org
CONTACT_CC=cbna.reca@gmail.com

# ─── MongoDB Atlas ───────────────────────────────────────────
# Chaîne de connexion : Atlas > Connect > Drivers
MONGODB_URI=
MONGODB_DB=cathbiz

# ─── Cloudinary (fichiers : CV, pièces d'adhésion, images) ───
# Dashboard Cloudinary > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier racine dans Cloudinary
CLOUDINARY_FOLDER=cathbiz

# ─── Authentification du back-office ─────────────────────────
# Clé secrète aléatoire (64 caractères hexadécimaux)
AUTH_SECRET=
# Durée d'une session admin, en jours
SESSION_MAX_AGE_DAYS=7
